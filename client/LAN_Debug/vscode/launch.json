{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "Debug: JLINK",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "${workspaceFolder}/Build/Debug/g4_template.elf",
            "runToEntryPoint": "main",
            "device": "STM32G474VE",
            "svdFile": "${workspaceFolder}/.pack/Keil/STM32G4xx_DFP.1.6.0/CMSIS/SVD/STM32G474.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "Debug: JLINK LAN",
            "servertype": "external",
            "gdbTarget": "127.0.0.1:2331",
            "preLaunchTask": "JLINK LAN: start GDB server",
            "executable": "${workspaceFolder}/Build/Debug/g4_template.elf",
            "runToEntryPoint": "main",
            "device": "STM32G474VE",
            "svdFile": "${workspaceFolder}/.pack/Keil/STM32G4xx_DFP.1.6.0/CMSIS/SVD/STM32G474.svd",
            "overrideLaunchCommands": [
                "monitor halt",
                "load",
                "monitor reset"
            ],
            "overrideRestartCommands": [
                "monitor reset"
            ]
        }
    ]
}
